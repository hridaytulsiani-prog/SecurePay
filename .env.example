# Template for the SERVER file (~/.env on the EC2) - copy the names, fill in your own values.
# Never commit the real file. Wrap values that contain spaces or < > # $ in single quotes.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=54.206.48.56,127.0.0.1,localhost,api.escrosafe.com
CORS_ALLOWED_ORIGINS=https://merchant.escrosafe.com,https://admin.escrosafe.com
CSRF_TRUSTED_ORIGINS=https://merchant.escrosafe.com,https://admin.escrosafe.com,https://api.escrosafe.com
BEHIND_HTTPS_PROXY=true

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Shared cache for login sessions (needed with more than one gunicorn worker)
REDIS_URL=redis://127.0.0.1:6379/1

# Merchant registration OTP email (Zoho CPaaS / ZeptoMail API)
ZEPTOMAIL_HOST=
ZEPTOMAIL_AGENT_ALIAS=
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM_EMAIL=
ZEPTOMAIL_FROM_NAME=
ZEPTOMAIL_TIMEOUT=8

# Temporary registration bypass; leave empty/remove for real use
REGISTER_OTP_BYPASS_CODE=

# Set these before real users arrive
ADMIN_ACCOUNT_SETUP_KEY=
GETGABS_API_KEY=
GETGABS_WHATSAPP_SENDER=
GETGABS_DELIVERY_TEMPLATE_NAME=
GETGABS_DELIVERY_TEMPLATE_LANGUAGE=
GETGABS_DELIVERY_CAMPAIGN_ID=
FRONTEND_ENQUIRY_URL=https://merchant.escrosafe.com/enquiry
OMNIWARE_PARTNER_ACCESS_TOKEN=
