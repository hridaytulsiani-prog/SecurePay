# Template for the SERVER file (~/.env on the EC2) - copy the names, fill in your own values.
# Never commit the real file. Wrap values that contain spaces or < > # $ in single quotes.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=54.206.48.56,127.0.0.1,localhost,api.escrosafe.com
CORS_ALLOWED_ORIGINS=https://merchant.escrosafe.com
CSRF_TRUSTED_ORIGINS=https://merchant.escrosafe.com,https://api.escrosafe.com
BEHIND_HTTPS_PROXY=true

DB_NAME=escrosafe
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Shared cache for login sessions (needed with more than one gunicorn worker)
REDIS_URL=redis://127.0.0.1:6379/1

# Email (AWS SES SMTP shown)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-southeast-2.amazonaws.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL='EscroSafe <no-reply@escrosafe.com>'

# Temporary registration bypass; leave empty/remove for real use
REGISTER_OTP_BYPASS_CODE=

# Set these before real users arrive
ADMIN_ACCOUNT_SETUP_KEY=
OMNIWARE_PARTNER_ACCESS_TOKEN=
